<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive core directories and files
    RewriteRule ^(\.env|composer\.(json|lock)|package\.(json|lock)|database/.*|storage/logs/.*) - [F,L,NC]

    # If request is not already targeting public/, redirect to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden dotfiles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
